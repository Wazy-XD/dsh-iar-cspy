{
  "name": "dsh-iar-cspy",
  "version": "2.1.0",
  "description": "DeepSeek Harness 插件：接入官方 IAR C-SPY MCP Server，在对话里编译、下载和调试 IAR Embedded Workbench 工程，并提供中文配置页与 iar-cspy 技能。",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "mcp",
    "iar",
    "cspy",
    "embedded",
    "debugger",
    "deepseek-harness"
  ],
  "type": "module",
  "main": "./index.js",
  "author": "Wazy-XD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wazy-XD/dsh-iar-cspy.git"
  },
  "homepage": "https://github.com/Wazy-XD/dsh-iar-cspy#readme",
  "bugs": {
    "url": "https://github.com/Wazy-XD/dsh-iar-cspy/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.ps1",
    "README.md",
    "README.en.md",
    "PARITY.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
